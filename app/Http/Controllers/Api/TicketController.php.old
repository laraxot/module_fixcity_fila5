<?php

declare(strict_types=1);

namespace Modules\Fixcity\app\Http\Controllers\Api;

use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;
use Illuminate\Http\Resources\Json\JsonResource;
use Illuminate\Routing\Controller;
use Modules\Fixcity\App\Enums\TicketStatusEnum;
use Modules\Fixcity\App\Http\Requests\Api\StoreTicketRequest;
use Modules\Fixcity\App\Http\Requests\Api\UpdateTicketRequest;
use Modules\Fixcity\App\Http\Resources\Api\TicketResource;
use Modules\Fixcity\App\Models\Ticket;
use Modules\Fixcity\App\Services\TicketWorkflowService;
use Modules\User\Models\User;

/**
 * API Controller per la gestione dei ticket.
 *
 * Fornisce endpoint RESTful per operazioni CRUD sui ticket
 * e funzionalità avanzate come cambio stato e assegnazione.
 */
final class TicketController extends Controller
{
    public function __construct(
        private readonly TicketWorkflowService $workflowService
    ) {
        $this->middleware('auth:sanctum');
    }

    /**
     * Lista tutti i ticket con filtri e paginazione.
     */
    public function index(Request $request): AnonymousResourceCollection
    {
        $query = Ticket::with(['user', 'profile', 'comments'])
            ->when($request->filled('status'), fn ($q, $status) => $q->where('status', $status))
            ->when($request->filled('priority'), fn ($q, $priority) => $q->where('priority', $priority))
            ->when($request->filled('type'), fn ($q, $type) => $q->where('type', $type))
            ->when($request->filled('search'), fn ($q, $search) => $q->where('name', 'like', "%{$search}%"))
            ->orderBy('created_at', 'desc');

        $tickets = $query->paginate((int) $request->get('per_page', 15));

        return TicketResource::collection($tickets);
    }

    /**
     * Mostra un ticket specifico.
     */
    public function show(Ticket $ticket): JsonResource
    {
        $ticket->load(['user', 'profile', 'comments', 'media']);

        return new TicketResource($ticket);
    }

    /**
     * Crea un nuovo ticket.
     */
    public function store(StoreTicketRequest $request): JsonResource
    {
        $ticket = Ticket::create($request->validated());

        // Carica le relazioni per la risposta
        $ticket->load(['user', 'profile', 'comments']);

        return new TicketResource($ticket);
    }

    /**
     * Aggiorna un ticket esistente.
     */
    public function update(UpdateTicketRequest $request, Ticket $ticket): JsonResource
    {
        $ticket->update($request->validated());

        // Carica le relazioni per la risposta
        $ticket->load(['user', 'profile', 'comments']);

        return new TicketResource($ticket);
    }

    /**
     * Elimina un ticket.
     */
    public function destroy(Ticket $ticket): JsonResponse
    {
        $ticket->delete();

        return response()->json(['message' => 'Ticket eliminato con successo']);
    }

    /**
     * Cambia lo stato di un ticket.
     */
    public function updateStatus(Request $request, Ticket $ticket): JsonResource
    {
        $request->validate([
            'status' => 'required|string|in:open,in_progress,review,assigned,approved,rejected,closed,draft',
        ]);

        $this->workflowService->transitionTo($ticket, TicketStatusEnum::from((string) $request->status));

        $ticket->load(['user', 'profile', 'comments']);

        return new TicketResource($ticket);
    }

    /**
     * Assegna un ticket a un utente.
     */
    public function assign(Request $request, Ticket $ticket): JsonResource
    {
        $request->validate([
            'user_id' => 'required|integer|exists:users,id',
        ]);

        $user = User::findOrFail((int) $request->user_id);
        $this->workflowService->assignTicket($ticket, $user);

        $ticket->load(['user', 'profile', 'comments']);

        return new TicketResource($ticket);
    }

    /**
     * Aggiunge un commento a un ticket.
     */
    public function addComment(Request $request, Ticket $ticket): JsonResource
    {
        $request->validate([
            'content' => 'required|string|max:1000',
        ]);

        $comment = $ticket->comments()->create([
            'content' => $request->content,
            'user_id' => auth()->id(),
        ]);

        $ticket->load(['user', 'profile', 'comments']);

        return new TicketResource($ticket);
    }

    /**
     * Cerca ticket con query avanzata.
     */
    public function search(Request $request): AnonymousResourceCollection
    {
        $request->validate([
            'q' => 'required|string|min:2',
            'filters' => 'sometimes|array',
        ]);

        $query = Ticket::with(['user', 'profile', 'comments'])
            ->where(function ($q) use ($request): void {
                $searchTerm = (string) $request->q;
                $q->where('name', 'like', "%{$searchTerm}%")
                    ->orWhere('description', 'like', "%{$searchTerm}%");
            });

        // Applica filtri aggiuntivi se forniti
        if ($request->filled('filters')) {
            $filters = (array) $request->filters;

            if (isset($filters['status']) && is_array($filters['status'])) {
                $query->whereIn('status', $filters['status']);
            }

            if (isset($filters['priority']) && is_array($filters['priority'])) {
                $query->whereIn('priority', $filters['priority']);
            }

            if (isset($filters['date_from']) && is_string($filters['date_from'])) {
                $query->whereDate('created_at', '>=', $filters['date_from']);
            }

            if (isset($filters['date_to']) && is_string($filters['date_to'])) {
                $query->whereDate('created_at', '<=', $filters['date_to']);
            }
        }

        $tickets = $query->orderBy('created_at', 'desc')
            ->paginate((int) $request->get('per_page', 15));

        return TicketResource::collection($tickets);
    }
}
