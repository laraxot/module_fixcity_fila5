                                    "spacing": "mb-4"
                                },
                                {
                                    "type": "button",
                                    "style": "primary",
                                    "label": "Richiedi iscrizione online",
                                    "element": "service-online-access"
                                },
                                {
                                    "type": "paragraph",
                                    "text": "Oppure, puoi prenotare un appuntamento e presentarti presso gli uffici.",
                                    "element": "service-generic-access",
                                    "spacing": "mt-4"
                                },
                                {
                                    "type": "button",
                                    "style": "outline",
