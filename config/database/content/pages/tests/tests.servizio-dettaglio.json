                    "sections": [
                        {
                            "id": "who-needs",
                            "title": "A chi è rivolto",
                            "type": "content",
                            "blocks": [
                                {
                                    "type": "richtext",
                                    "element": "service-addressed",
                                    "nodes": [
                                        {
                                            "type": "list",
                                            "items": [
                                                "Bambini di età compresa tra i 3 e i 5 anni compiuti o da compiere entro il 31 dicembre di ogni anno.",
                                                "Bambini che compiranno i 3 anni dopo il 31 dicembre e, comunque, entro e non oltre il 30 aprile dell’anno successivo (ammissione anticipata)."
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "description",
                            "title": "Descrizione",
                            "type": "content",
                            "blocks": [
                                {
                                    "type": "richtext",
                                    "element": "",
                                    "nodes": [
                                        {
                                            "type": "p",
                                            "segments": [
                                                "Le domande di iscrizione devono essere presentate alle scuole nei mesi di gennaio/febbraio. L'Amministrazione pubblica un avviso con le modalità di accesso e i termini di presentazione della domanda.",
                                                "",
                                                "Le graduatorie ai fini dell'inserimento dei bambini sono curate dal Servizio Istruzione del Comune che le approva con determinazione dirigenziale."
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "how-to",
                            "title": "Come fare",
                            "type": "content",
                            "blocks": [
                                {
                                    "type": "richtext",
                                    "element": "service-how-to",
                                    "nodes": [
                                        {
                                            "type": "p",
                                            "segments": [
                                                "Puoi presentare la richiesta di iscrizione esclusivamente online dalle ore 10:00 del 4 gennaio 2022 alle 20:00 del 4 febbraio 2022. I posti assegnati vanno accettati entro 15 giorni dalla pubblicazione della graduatoria."
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "needed",
                            "title": "Cosa serve",
                            "type": "content",
                            "blocks": [
                                {
                                    "type": "richtext",
                                    "element": "service-needed",
                                    "nodes": [
                                        {
                                            "type": "p",
                                            "segments": [
                                                "Per accedere al servizio, assicurati di avere:"
                                            ]
                                        },
                                        {
                                            "type": "list",
                                            "items": [
                                                "SPID (Sistema Pubblico per la gestione dell'Identità Digitale), Carta identità elettronica (CIE) o Carta Nazionale dei Servizi (CNS);",
                                                "la documentazione attestante eventuali disabilità",
                                                "il permesso di soggiorno del genitore che presenta la richiesta",
                                                "l’ISEE in corso di validità"
                                            ]
                                        }
                                    ]
                                }
                            ],
                            "box": {
                                "padding": 3
                            }
                        },
                        {
                            "id": "obtain",
                            "title": "Cosa si ottiene",
                            "type": "content",
                            "blocks": [
                                {
                                    "type": "richtext",
                                    "element": "service-achieved",
                                    "nodes": [
                                        {
                                            "type": "p",
                                            "segments": [
                                                "Se - in base ai requisiti e alla graduatoria - la richiesta verrà accettata, sarà possibile perfezionare l’iscrizione all’asilo."
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
