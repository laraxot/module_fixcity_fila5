                    "sections": [
                        {
                            "type": "flow",
                            "id": "who-needs",
                            "class": "mb-30",
                            "title": "A chi è rivolto",
                            "title_class": "title-xxlarge mb-3",
                            "items": [
                                {
                                    "type": "paragraph",
                                    "text": "Persone fisiche con residenza anagrafica in zone a traffico limitato:",
                                    "class": "text-paragraph lora mb-0"
                                },
                                {
                                    "type": "list",
                                    "items": [
                                        "proprietarie di veicolo;",
                                        "con veicolo in leasing;",
                                        "con veicolo acquistato con patto di riservato dominio;",
                                        "con veicolo in locazione con facoltà di acquisto o in usufrutto (regolarmente trascritti sui documenti del veicolo);",
                                        "con veicolo a noleggio intestato ad azienda della quale il residente è titolare;",
                                        "con veicolo concesso in fringe benefit."
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "flow",
                            "id": "description",
                            "class": "mb-30",
                            "title": "Descrizione",
                            "title_class": "title-xxlarge mb-3",
                            "items": [
                                {
                                    "type": "paragraph",
                                    "text": "L'autorizzazione consente il transito e la sosta h 24 dei veicoli nelle zone a traffico limitato.\n\nIl permesso ZTL è valido per 5 anni dalla data del rilascio e si può rinnovare da due mesi prima della data di scadenza.",
                                    "class": "text-paragraph lora"
                                }
                            ]
                        },
                        {
                            "type": "flow",
                            "id": "how-to",
                            "class": "mb-30",
                            "title": "Come fare",
                            "title_class": "title-xxlarge mb-3",
                            "items": [
                                {
                                    "type": "paragraph",
                                    "text": "La richiesta può essere inviata online o consegnata di persona all’Ufficio Protocollo Generale, in via dei Transiti 21.\n\nIn caso di esito positivo dell'istruttoria il permesso viene inviato nella casella di posta elettronica indicata nella richiesta.",
                                    "class": "text-paragraph lora"
                                }
                            ]
                        },
                        {
                            "type": "flow",
                            "id": "needed",
                            "class": "mb-30 has-bg-grey p-3",
                            "title": "Cosa serve",
                            "title_class": "title-xxlarge mb-3",
                            "items": [
                                {
                                    "type": "paragraph",
                                    "text": "Per accedere al servizio, assicurati di avere:",
                                    "class": "text-paragraph lora mb-0"
                                },
                                {
                                    "type": "list",
                                    "items": [
                                        "SPID (Sistema Pubblico per la gestione dell'Identità Digitale), Carta identità elettronica (CIE) o Carta Nazionale dei Servizi (CNS);",
                                        "Numero di targa del veicolo;",
                                        "Patente di guida del richiedente."
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "flow",
                            "id": "obtain",
                            "class": "mb-30",
                            "title": "Cosa si ottiene",
                            "title_class": "title-xxlarge mb-3",
                            "items": [
                                {
                                    "type": "paragraph",
                                    "text": "Si ottiene un permesso da esporre sul parabrezza del veicolo durante tutto il tempo di durata del transito e della sosta in ZTL o da esibire, a richiesta degli agenti addetti al controllo, quando è associato a veicoli che non consentono la chiusura a chiave dell’abitacolo.",
                                    "class": "text-paragraph lora"
                                }
                            ]
                        },
                        {
                            "type": "permessi-timeline",
                            "id": "deadlines",
                            "class": "mb-30",
                            "title": "Tempi e scadenze",
                            "entries": [
                                {
                                    "year": "",
                                    "day": "",
                                    "month": "",
                                    "label": "Esito richiesta",
                                    "info": "Si riceve all’indirizzo email indicato nella richiesta",
                                    "info_class": "info-text mt-1 mb-0"
                                },
                                {
                                    "year": "",
                                    "day": "10",
                                    "month": "giorni",
                                    "label": "Pagamento"
                                },
                                {
                                    "year": "",
                                    "day": "02",
                                    "month": "giorni",
                                    "label": "Rilascio permesso ZTL"
                                }
                            ]
                        },
                        {
                            "type": "flow",
                            "id": "costs",
                            "class": "mb-30",
                            "title": "Costi",
                            "title_class": "title-xxlarge mb-3",
                            "items": [
                                {
                                    "type": "paragraph",
                                    "text": "L’importo del permesso ZTL per il centro storico è di € 5,00. La tariffa non è dovuta alla scadenza del permesso in caso di rinnovo, quando sia effettuato in continuità di validità del precedente pass in scadenza. Non è considerato rinnovo quello del permesso scaduto da oltre un anno.",
                                    "class": "text-paragraph lora"
                                },
                                {
                                    "type": "attachment",
                                    "label": "Allegato se necessario (PDF 1MB)",
                                    "aria": "Scarica Allegato se necessario (PDF 1MB)",
                                    "title": "Scarica Allegato se necessario (PDF 1MB)",
                                    "url": "#"
                                }
                            ]
                        },
                        {
                            "type": "flow",
                            "id": "service-access",
                            "class": "mb-30 has-bg-grey p-3 p-lg-4",
                            "title": "Accedi al servizio",
                            "title_class": "mb-3",
                            "items": [
                                {
                                    "type": "paragraph",
                                    "text": "Puoi richiedere il permesso ZTL direttamente online tramite identità digitale.",
                                    "class": "text-paragraph lora mb-4"
                                },
                                {
                                    "type": "button",
                                    "label": "Richiedi online",
                                    "class": "btn btn-primary mobile-full"
                                },
                                {
                                    "type": "paragraph",
                                    "text": "Oppure, puoi prenotare un appuntamento e presentarti presso gli uffici.",
                                    "class": "text-paragraph lora mt-4"
                                },
                                {
                                    "type": "button",
                                    "label": "Prenota appuntamento",
                                    "class": "btn btn-outline-primary t-primary bg-white mobile-full"
                                }
                            ]
                        },
                        {
                            "type": "flow",
                            "id": "conditions",
                            "class": "mb-30",
                            "title": "Condizioni di servizio",
                            "title_class": "title-xxlarge mb-3",
                            "items": [
                                {
                                    "type": "paragraph",
                                    "text": "Per conoscere i dettagli di scadenze, requisiti e altre informazioni importanti, leggi i termini e le condizioni di servizio.",
                                    "class": "text-paragraph lora"
                                },
                                {
