    "visual_language": {"complexity": "moderate", "ornamentation": "subtle accents", "whitespace_usage": "generous around headings and sections", "visual_weight_distribution": "content-first with restrained colored bands", "focal_strategy": "progressive reveal from task to detail", "contrast_level": "high", "texture_usage": "none"},
